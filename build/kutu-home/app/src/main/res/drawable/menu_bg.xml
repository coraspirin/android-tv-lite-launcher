<?xml version="1.0" encoding="utf-8"?>
<!-- A modal card needs more opacity than the dock, so it separates from the frosted veil
     instead of dissolving into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
    android:dither="true">
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="@color/menu_glass_top"
        android:endColor="@color/menu_glass_bottom" />
    <corners android:radius="@dimen/menu_radius" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
</shape>
