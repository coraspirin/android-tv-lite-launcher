<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_glass_focused" />
            <corners android:radius="@dimen/chip_radius" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_glass" />
            <corners android:radius="@dimen/chip_radius" />
            <stroke android:width="1dp" android:color="@color/shelf_stroke" />
        </shape>
    </item>
</selector>
