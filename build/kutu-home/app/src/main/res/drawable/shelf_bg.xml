<?xml version="1.0" encoding="utf-8"?>
<!--
    The shelf pane.

    Deliberately a single <shape> and not a <layer-list>: HomeActivity puts
    ViewOutlineProvider.BACKGROUND on the shelf and clips to that outline, and a lone
    GradientDrawable always reports a correct rounded-rect outline. A layer-list would
    take its outline from whichever child layer answered first.

    angle=270 runs the gradient top -> bottom, so startColor is the bright top edge and
    the pane falls away below it. That falloff, not a blur, is what reads as glass.
    dither is required: an 8-bit 1080p panel bands on a gradient this shallow.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
    android:dither="true">
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="@color/glass_shelf_top"
        android:centerColor="@color/glass_shelf_mid"
        android:endColor="@color/glass_shelf_bottom" />
    <corners android:radius="@dimen/shelf_radius" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
</shape>
