<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        guide 17: supplied image, used verbatim, fitted to 16:9 without stretch. The human
        may replace it from Kutu Home's settings with a photo sent through Kutu Aktarım;
        HomeSettings.applyBackground swaps the drawable, everything else stays as it is.

        bg_scrim is transparent in the light theme and dark in the night one, so the dark
        theme dims this image rather than shipping a second copy of it. It is a foreground
        on the ImageView and not on the root on purpose: on the root it would darken the
        glass and the text along with the wallpaper.
    -->
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:foreground="@color/bg_scrim"
        android:scaleType="centerCrop"
        android:src="@drawable/kutu_home_background" />

    <!-- top-left: Kutu Home settings (theme, background, shelf size, updates);
         mirrors the clock block at top-right -->
    <ImageView
        android:id="@+id/settings_button"
        android:layout_width="@dimen/settings_button"
        android:layout_height="@dimen/settings_button"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/overscan_h"
        android:layout_marginTop="@dimen/overscan_v"
        android:background="@drawable/theme_toggle_bg"
        android:contentDescription="@string/kutu_settings"
        android:focusable="true"
        android:padding="@dimen/settings_button_pad"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_gear" />

    <!-- calm upper area: time, date and the status line, top-right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/overscan_v"
        android:layout_marginEnd="@dimen/overscan_h"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/ink"
            android:textSize="@dimen/clock_time" />

        <TextView
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/clock_date" />

        <!-- Wi-Fi name / "Bağlı değil", and the remote's battery when it can be read -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/net_icon"
                android:layout_width="@dimen/status_icon"
                android:layout_height="@dimen/status_icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                android:tint="@color/ink_dim" />

            <TextView
                android:id="@+id/net_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxWidth="@dimen/status_label_max"
                android:maxLines="1"
                android:textColor="@color/ink_dim"
                android:textSize="@dimen/status_text" />

            <ImageView
                android:id="@+id/battery_icon"
                android:layout_width="@dimen/status_icon"
                android:layout_height="@dimen/status_icon"
                android:layout_marginStart="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_remote_battery"
                android:tint="@color/ink_dim"
                android:visibility="gone" />

            <TextView
                android:id="@+id/battery_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:textColor="@color/ink_dim"
                android:textSize="@dimen/status_text"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!--
        The shelf is centred and everything else is anchored to it, rather than the four
        being stacked and the stack centred. A stack centres its TOTAL height, which would
        put the shelf off centre by half the difference between the label and the chips,
        and - worse - move_hint appears and disappears with move mode, so the dock would
        jump every time a tile was picked up. Anchored, the shelf depends on nothing and
        nothing a sibling does can shift it.

        clipChildren is false so the chips' focus lift shadow can escape the tight wrap of
        chips_row; a parent has to allow that for its children.
    -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!--
            One centered translucent light-glass shelf.

            clipToPadding is true so a partially scrolled icon is hard-clipped at the
            content box and can never bleed into the shelf's rounded edge. It used to
            be false with a fading edge, which did not remove the overflow at all - it
            only made it semi-transparent, so half-icons stayed visible under the
            gradient. The fading edge is gone for the same reason.

            Room for the focused tile's 114% scale and its glow now lives INSIDE the
            clip box, as padding on dock_row, so the hover effect is no longer cut off.
            ShelfScrollView keeps it that way while scrolling: it only stops on whole
            tiles, so the focused one is never pushed half outside the clip box.
        -->
        <local.kutu.home.ShelfScrollView
            android:id="@+id/shelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/shelf_bg"
            android:clipToPadding="true"
            android:paddingStart="@dimen/shelf_padding"
            android:paddingTop="@dimen/shelf_padding_v"
            android:paddingEnd="@dimen/shelf_padding"
            android:paddingBottom="@dimen/shelf_padding_v"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dock_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/row_padding"
                android:paddingTop="@dimen/row_padding"
                android:paddingEnd="@dimen/row_padding"
                android:paddingBottom="@dimen/row_padding" />
        </local.kutu.home.ShelfScrollView>

        <!-- focused app name, shown once (guide 18) -->
        <TextView
            android:id="@+id/focused_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/shelf"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/ink"
            android:textSize="@dimen/focused_label" />

        <!--
            One dot per page of the shelf, shown only when it scrolls. Chained like
            move_hint: RelativeLayout walks past a GONE anchor, so the hint and the chips
            sit directly under the shelf whenever there are no dots.
        -->
        <LinearLayout
            android:id="@+id/page_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/shelf"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/move_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/page_dots"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/hint_text"
            android:text="@string/move_hint"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/chips_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/move_hint"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal" />
    </RelativeLayout>
</FrameLayout>
