<?xml version="1.0" encoding="utf-8"?>
<!-- Same two-layer structure as view_tile.xml; see the note there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile"
    android:layout_width="@dimen/allapps_outer"
    android:layout_height="@dimen/allapps_outer"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:padding="@dimen/tile_inset">

    <FrameLayout
        android:id="@+id/tile_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_bg"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="@dimen/allapps_icon"
            android:layout_height="@dimen/allapps_icon"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <!-- white dot: this app is already on the home shelf. Inside the card so it scales
             and lifts with it on focus. -->
        <ImageView
            android:id="@+id/on_home_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/on_home_dot"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
