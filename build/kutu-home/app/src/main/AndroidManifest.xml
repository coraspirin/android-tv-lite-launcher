<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        guide 15: Kutu Home still holds no INTERNET permission: the launcher cannot reach
        the network. Everything below only reads state on the box.

        REQUEST_DELETE_PACKAGES: so ACTION_UNINSTALL_PACKAGE can show Android's own
        confirmation dialog. Kutu Home never uninstalls silently.
        ACCESS_NETWORK_STATE, ACCESS_WIFI_STATE: whether and to which Wi-Fi the box is
        connected, for the line under the clock. Neither gives network access.
        ACCESS_COARSE_LOCATION: Android 9 shows an app the Wi-Fi network's NAME only if it
        holds location access. It is the one runtime ("dangerous") permission here; it is
        granted once at setup (pm grant) and used for nothing else - Kutu Home never asks
        for a location. Without it the line says "Wi-Fi bağlı" instead of the name.
        BLUETOOTH: reads the remote's battery level from its BLE Battery Service.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/kutu_banner"
        android:hardwareAccelerated="true"
        android:icon="@drawable/kutu_icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/KutuTheme">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/KutuTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- kept so the app can be launched and tested from the current
                     launcher before it is promoted to HOME (guide 24) -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/KutuTheme" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/KutuTheme.Transparent" />

        <activity
            android:name=".BackgroundActivity"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/KutuTheme" />

        <activity
            android:name=".MirrorPanelActivity"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/KutuTheme.Transparent" />

        <!-- screen saver: the setup points screensaver_components here when the stock
             one is disabled; bound by the system only while dreaming -->
        <service
            android:name=".KutuDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>

</manifest>
